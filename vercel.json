{
    "rewrites": [
        {
            "source": "/",
            "has": [
                { "type": "query", "key": "om" },
                { "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Discordbot|TelegramBot|Slackbot).*" }
            ],
            "destination": "/api/metadata"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}