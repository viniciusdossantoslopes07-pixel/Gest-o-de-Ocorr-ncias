{
    "redirects": [
        {
            "source": "/",
            "has": [
                { "type": "query", "key": "om", "value": "(?<om>[^&]+)" }
            ],
            "missing": [
                { "type": "query", "key": "realApp" }
            ],
            "destination": "/api/metadata?om=:om",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}