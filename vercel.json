{
    "rewrites": [
        {
            "source": "/",
            "has": [
                { "type": "query", "key": "om" }
            ],
            "missing": [
                { "type": "query", "key": "realApp" }
            ],
            "destination": "/api/metadata"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}